# Copy this file to .env at the monorepo root.
# Do not commit real API keys.

# Shared defaults used by both Simplifi_Edu and Inspirer_Edu.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash-lite
LLM_TEMPERATURE=0.3

# Set keys for the providers you use.
GEMINI_API_KEY=put_your_gemini_api_key_here
OPENAI_API_KEY=put_your_openai_api_key_here

# Optional per-agent overrides.
# PRESET_LLM_PROVIDER=gemini
# PRESET_LLM_MODEL=gemini-2.5-flash-lite
# PRESET_LLM_TEMPERATURE=0.3
# PRESET_GEMINI_API_KEY=put_your_gemini_api_key_here
# PRESET_OPENAI_API_KEY=put_your_openai_api_key_here

# INSPIRER_LLM_PROVIDER=gemini
# INSPIRER_LLM_MODEL=gemini-2.5-flash-lite
# INSPIRER_LLM_TEMPERATURE=0.3
# INSPIRER_GEMINI_API_KEY=put_your_gemini_api_key_here
# INSPIRER_OPENAI_API_KEY=put_your_openai_api_key_here